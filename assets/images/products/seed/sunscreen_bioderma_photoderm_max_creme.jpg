        padding: 0 5px !important; /* Espaço mínimo para caber tudo na mesma linha */
    }

    /* 2. BANNER EUCERIN: Fix de 0.450 CLS */
    /* Removemos o fundo cinza e forçamos a altura real */
    .beautify__flexBanners {
        height: 243px !important;
        min-height: 243px !important;
        display: block !important;
        overflow: hidden;
    }

    .beautify__flexBanners img, 
    img[alt="eucerin promo"] {
        width: 100% !important;
        height: 243px !important;
        object-fit: cover !important;
        aspect-ratio: 1170 / 243;
    }

    /* 3. PRODUTOS: 6 colunas sem espaço vazio */
    .beautify__productsFeed .productGrid {
        display: flex !important;
        flex-wrap: wrap !important;
        justify-content: flex-start;
        min-height: 450px; /* Reserva o espaço da linha */
    }

    .beautify__productsFeed .productGrid .product {
        width: 16.666% !important;
        flex: 0 0 16.666% !important;
        padding: 0 8px !important;
        margin-bottom: 20px;
    }

    /* 4. IMAGENS DOS PRODUTOS: Fim do fundo cinza */
    .product-card .card-img-container, 
    .product-card .card-figure {
        height: auto !important;
        padding-bottom: 0 !important; /* Remove o espaço cinza extra */
        aspect-ratio: 1 / 1 !important; /* Reserva o quadrado sem erro */
        background: transparent !important;
    }

    .product-card img.card-image {
        width: 100% !important;
        height: auto !important;
        object-fit: contain !important; /* Garante que a foto aparece inteira */
    }

    /* 5. TEXTOS: Alinhamento vertical */
    .product-card .card-title {
        min-height: 2.8em !important;
        max-height: 2.8em !important;
        line-height: 1.4em;
        margin-top: 10px !important;
        overflow: hidden;
    }

    .product-card .card-text--price {
        min-height: 1.5em !important;
    }
}

/* 6. HERO BANNER (Top) */
.page-type-default .swiper.hero-banners-3 {
    min-height: 220px !important;
    height: 220px !important;
}

    .productGrid .card {
        border: none !important;
        box-shadow: none !important;
    }
}

/* slide produtos */

/* WRAPPER */
.brands-slider-wrapper {
    width: 100%;
    overflow: hidden;
}

.brands-slider {
    display: flex;
    transition: transform .6s ease;
}

.brand-slide {
    min-width: 100%;
    padding: 20px 0;
}

/* TÍTULO */
.brand-title {
    text-align: center;
    font-size: 24px;
    margin-bottom: 25px;
    position: relative;
}

/* remove decoração do tema */
.brand-title::before,
.brand-title::after {
    display: none !important;
    content: none !important;
}

.brand-title a {
    text-decoration: none;
    color: inherit;
}

/* PRODUTOS */
.brand-products {
    display: flex;
    gap: 8px;
    overflow: hidden;
    max-width: 1350px;
    margin: 0 auto;
}

/* DESKTOP - 6 produtos */
.brand-products .product {
    flex: 0 0 calc(16.66% - 6px);
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    border: none;
    background: none;
}

/* remove estilos internos do Beautify */
.brand-products .card,
.brand-products .card-body {
    border: none !important;
    box-shadow: none !important;
    padding: 5px;
}

/* HOVER */
.brand-products .product {
    transition: all .2s ease;
    position: relative;
    z-index: 1;
}

.brand-products .product:hover {
    transform: translateY(-4px);
    z-index: 5;
    /* fica acima dos outros */
}

.brand-products .product:hover .card {
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    border-radius: 6px;
}

/* TABLET - 4 produtos */
@media (max-width: 1024px) {
    .brand-products .product {
        flex: 0 0 calc(25% - 6px);
    }
}

/* MOBILE - 2 produtos */
@media (max-width: 600px) {
    .brand-products {
        gap: 6px;
    }
}


/* Remover os botões da página de checkout: */

.page-type-cart .chiara__carousel button.slick-arrow {
    display: none !important;
}

.page-type-default .beautify__productsFeed article.card.card-text.card-hover {
    border: none;
}
</style> 


        
        
 <!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">

<style>
body{
    font-family: Arial;
}

.slider-container{
    width: 100%;
    overflow: hidden;
    position: relative;
}

.slider{
    display: flex;
    transition: transform 0.4s ease;
}

.product{
    width: calc(100% / 6);
    padding: 10px;
    box-sizing: border-box;
}

.card{
    border:1px solid #eee;
    border-radius:8px;
    text-align:center;
    padding:10px;
}

.card img{
    width:100%;
    height:150px;
    object-fit:cover;
}

.controls{
    text-align:center;
    margin-top:10px;
}

button{
    padding:8px 14px;
    cursor:pointer;
}
</style>

</head>

</html>       
        
        
    </body>
</html>
