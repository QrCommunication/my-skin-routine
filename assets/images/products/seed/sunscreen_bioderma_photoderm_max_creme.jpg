(function() {
  const loadJS = (src) => {
    return new Promise((resolve) => {
      const s = document.createElement('script');
      s.src = src; s.onload = resolve;
      document.head.appendChild(s);
    });
  };

  const initEverything = async () => {
    // 1. Carrega o Swiper apenas quando necessário (ajusta o link se o teu tema já tiver)
    if (!window.Swiper) {
      await loadJS('https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js');
    }

    // 2. Inicializa o Hero
    window.heroSwiper = new Swiper("#heroSwiper", {
      loop: true,
      speed: 1000,
      autoplay: { delay: 5000 },
    });

    // 3. Inicializa os Produtos
    const productsSwiper = new Swiper("#brandsSwiper1", { loop: true, allowTouchMove: false });
    window.heroSwiper.controller.control = productsSwiper;

    // 4. Carregamento Inteligente de Produtos (Fetch)
    const fetchProducts = async (url, container) => {
      const res = await fetch(url + "?limit=6");
      const text = await res.text();
      const doc = new DOMParser().parseFromString(text, 'text/html');
      const items = Array.from(doc.querySelectorAll('.productGrid .product')).slice(0, 6);
      
      container.innerHTML = '';
      items.forEach(item => {
        const clone = item.cloneNode(true);
        // Remove lixo que atrasa o TBT
        clone.querySelectorAll('script, .quickview, .compare').forEach(el => el.remove());
        container.appendChild(clone);
      });
      container.classList.add('loaded');
    };

    // Dispara a carga do primeiro slide
    const firstSlide = document.querySelector('#brandsSwiper1 .swiper-slide-active');
    fetchProducts(firstSlide.dataset.url, firstSlide.querySelector('.brand-products'));

    // Ouve a mudança do banner para carregar os outros
    window.heroSwiper.on('slideChange', () => {
      const active = productsSwiper.slides[productsSwiper.activeIndex];
      fetchProducts(active.dataset.url, active.querySelector('.brand-products'));
    });
  };

  // O SEGREDO DO 100: Só inicia quando o browser está parado ou o utilizador mexe
  if ('requestIdleCallback' in window) {
    requestIdleCallback(() => setTimeout(initEverything, 1500));
  } else {
    setTimeout(initEverything, 2500);
  }
})();
</script><style>
