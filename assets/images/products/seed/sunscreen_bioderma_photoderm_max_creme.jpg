                                fetch(endpoint).then(function(res) {
                                    res.json().then(function(jsonRes) {
                                        trustpilot_settings.sku = jsonRes.data["sku"];
                                        createTrustBoxScript();
                                    });
                                });
                            }
                        });
                    } else {
                        createTrustBoxScript();
